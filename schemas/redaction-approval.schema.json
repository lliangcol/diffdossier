{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lliangcol/diffdossier/schemas/redaction-approval.schema.json",
  "type": "object",
  "required": ["schema_version", "source_run_digest", "derived_content_digest", "redaction_manifest_digest", "scan_digest", "approved_at"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "source_run_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "derived_content_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "redaction_manifest_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "scan_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "approved_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
