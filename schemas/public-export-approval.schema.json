{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lliangcol/diffdossier/schemas/public-export-approval.schema.json",
  "type": "object",
  "required": ["binding", "approved_by", "digest", "revoked"],
  "properties": {
    "binding": {"type": "object", "required": ["schema_version", "candidate_digest", "data_class", "action", "policy_digest", "scan_digest", "approved_at"], "properties": {
      "schema_version": {"const": "1.0"}, "candidate_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}, "data_class": {"enum": ["public_synthetic", "public_project", "redacted_summary"]}, "action": {"enum": ["create", "replace"]}, "policy_digest": {"type": "string", "minLength": 1}, "scan_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}, "redaction_approval_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}, "approved_at": {"type": "string", "format": "date-time"}
    }, "additionalProperties": false},
    "approved_by": {"type": "string", "minLength": 1},
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "revoked": {"type": "boolean"}
  },
  "additionalProperties": false
}
