{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lliangcol/diffdossier/schemas/task.schema.json",
  "type": "object",
  "required": ["schema_version", "task_id", "snapshot_id", "risk", "contract_types", "paths", "dependency_tasks", "total_bytes", "oversized", "needs_confirmation", "required_passes", "perspectives"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "task_id": {"type": "string", "pattern": "^task-[a-f0-9]{24}$"},
    "snapshot_id": {"type": "string", "pattern": "^snap-[a-f0-9]{64}$"},
    "risk": {"enum": ["L0", "L1", "L2", "L3", "L4"]},
    "contract_types": {"type": "array", "items": {"type": "string"}},
    "paths": {"type": "array", "minItems": 1},
    "dependency_tasks": {"type": "array", "items": {"type": "string"}},
    "total_bytes": {"type": "integer", "minimum": 0},
    "oversized": {"type": "boolean"},
    "needs_confirmation": {"type": "boolean"},
    "required_passes": {"type": "integer", "minimum": 1},
    "perspectives": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  },
  "additionalProperties": false
}
