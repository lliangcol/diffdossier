{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lliangcol/diffdossier/schemas/review-comparison.schema.json",
  "type": "object",
  "required": ["schema_version", "pass_ids", "reviewers", "independent", "independence_evidence", "overlap", "unique", "disagreements"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "pass_ids": {"type": "array", "items": {"type": "string"}},
    "reviewers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["provider", "model", "model_family", "pass_id", "perspective", "prompt_digest", "context_isolation"],
        "properties": {
          "provider": {"type": "string", "minLength": 1},
          "model": {"type": "string", "minLength": 1},
          "model_family": {"type": "string", "minLength": 1},
          "pass_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "perspective": {"type": "string", "minLength": 1},
          "prompt_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
          "context_isolation": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "independent": {"type": "boolean"},
    "independence_evidence": {"type": "array", "items": {"type": "string"}},
    "overlap": {"type": "array", "items": {"type": "string"}},
    "unique": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "string"}}},
    "disagreements": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
