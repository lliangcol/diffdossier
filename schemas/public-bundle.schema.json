{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lliangcol/diffdossier/schemas/public-bundle.schema.json",
  "type": "object",
  "required": ["schema_version", "content", "content_digest", "artifact_class", "action", "policy_digest", "scan_digest", "public_export_approval_record_digest", "bundle_digest"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "content": {"type": "string", "contentEncoding": "base64"},
    "content_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "artifact_class": {"enum": ["public_synthetic", "public_project", "redacted_summary"]},
    "action": {"enum": ["create", "replace"]},
    "policy_digest": {"type": "string", "minLength": 1},
    "scan_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "public_revision": {"type": "string", "minLength": 1},
    "public_export_approval_record_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "bundle_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
  },
  "additionalProperties": false
}
