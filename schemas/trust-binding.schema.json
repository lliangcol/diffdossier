{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lliangcol/diffdossier/schemas/trust-binding.schema.json",
  "type": "object",
  "required": ["repository_id", "snapshot_id", "task_input_digest", "execution_plan_digest", "config_digest", "binary_digest", "capability", "expires_at"],
  "properties": {
    "repository_id": {"type": "string", "minLength": 1},
    "snapshot_id": {"type": "string", "minLength": 1},
    "task_input_digest": {"type": "string", "minLength": 1},
    "execution_plan_digest": {"type": "string", "minLength": 1},
    "config_digest": {"type": "string", "minLength": 1},
    "binary_digest": {"type": "string", "minLength": 1},
    "capability": {"type": "string", "minLength": 1},
    "expires_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
