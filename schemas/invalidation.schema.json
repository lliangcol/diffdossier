{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lliangcol/diffdossier/schemas/invalidation.schema.json",
  "type": "object",
  "required": ["schema_version", "must_reload", "reasons"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "must_reload": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^task-[a-f0-9]{24}$"}},
    "reasons": {"type": "object", "additionalProperties": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["semantic input changed", "direct path changed", "dependency neighbor changed", "dependent neighbor changed", "shared contract consumer changed"]}}}
  },
  "additionalProperties": false
}
