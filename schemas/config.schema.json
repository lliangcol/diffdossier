{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lliangcol/diffdossier/schemas/config.schema.json",
  "title": "diffdossier.toml logical model",
  "type": "object",
  "required": ["schema_version", "baseline"],
  "properties": {
    "schema_version": {"const": 1},
    "baseline": {"type": "string", "minLength": 1},
    "include_untracked": {"type": "boolean"},
    "include_ignored": {"type": "array", "items": {"type": "string"}},
    "review": {"type": "object"},
    "state": {"type": "object"},
    "risk": {"type": "object"},
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "argv", "cwd", "env_allowlist", "when_paths", "depends_on", "timeout_seconds", "resource_class", "blocking", "cache_class", "final_always", "network_class", "expected_writes", "redaction_policy"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "cwd": {"type": "string", "minLength": 1},
          "env_allowlist": {"type": "array", "items": {"type": "string"}},
          "when_paths": {"type": "array", "items": {"type": "string"}},
          "depends_on": {"type": "array", "items": {"type": "string"}},
          "timeout_seconds": {"type": "integer", "minimum": 1},
          "resource_class": {"enum": ["cpu", "io", "exclusive", "network", "external"]},
          "blocking": {"type": "boolean"},
          "cache_class": {"enum": ["worktree_deterministic", "host_volatile", "time_network", "external"]},
          "final_always": {"type": "boolean"},
          "network_class": {"enum": ["none", "local", "external"]},
          "expected_writes": {"type": "array", "items": {"type": "string"}},
          "redaction_policy": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
