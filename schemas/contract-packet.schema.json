{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lliangcol/diffdossier/schemas/contract-packet.schema.json",
  "type": "object",
  "required": ["schema_version", "snapshot_id", "data_class", "prompt", "prompt_digest", "input_digest", "contract_graph"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "snapshot_id": {"type": "string", "pattern": "^snap-[a-f0-9]{64}$"},
    "data_class": {"enum": ["public_synthetic", "public_project", "private_project"]},
    "prompt": {"type": "string", "minLength": 1},
    "prompt_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "input_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "contract_graph": {"$ref": "contract-graph.schema.json"}
  },
  "additionalProperties": false
}
